# =====================================================================
# mining_camp.place - test mining and woodcutting camp east of the Cameron start
# =====================================================================
# .place files are read after the .map files of the area. They add things
# to the map without changing the .map: at="x,y" picks a tile (the tile must
# not have an item yet), then it=<item template> puts an item there.
# Templates are in zones/generic/skilling.itm.

at="132,181"
it=furnace
at="134,181"
it=anvil
at="129,181"
it=mining_supplies

at="136,183"
it=rock_copper
at="138,183"
it=rock_copper
at="140,183"
it=rock_tin
at="136,186"
it=rock_tin
at="138,186"
it=rock_iron
at="140,186"
it=rock_coal

