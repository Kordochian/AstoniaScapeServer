# ------ Player Definitions: ------

# New characters are created from new_player_m / new_player_f (classless).
# The old warrior/mage/seyan templates below are kept for reference only.

new_player_m:
name="Newbie"
description="This is, quite obviously, a newbie."
sprite=2
sound=1

flag=CF_PLAYER
flag=CF_MALE
flag=CF_ALIVE

# Classless start (Astonia rebuild). Every skill starts low and levels by use.
# Skills use their keys from zones/generic/skills.cfg (SK_<KEY>=level).
# Anything left out starts at the start= level from skills.cfg.

# powers
SK_HP=25
SK_ENDURANCE=25
SK_MANA=25

# combat (no attributes: each skill does one job)
SK_ATTACK=1
SK_STRENGTH=1
SK_DEFENCE=1
SK_WARCRY=1
SK_ATHLETICS=1
SK_SLAYER=1

# magic and support
SK_MAGIC=1
SK_REGENERATE=1
SK_STEALTH=1
SK_PERCEPTION=1

# gathering and production
SK_MINING=1
SK_WOODCUTTING=1
SK_FARMING=1
SK_SMITHING=1
SK_CRAFTING=1

WN_RHAND=sword1q1
WN_BODY=armor1q1
WN_LEGS=leggings1q1
WN_ARMS=sleeves1q1
WN_HEAD=helmet1q1

item=torch
item=torch
item=healing_potion1
item=mana_potion1
item=recall_scroll2
;

