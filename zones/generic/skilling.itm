# =====================================================================
# skilling.itm - items of Mining, Smithing, Woodcutting and Crafting
# =====================================================================
# Plain item templates. skilling.cfg says what each one is (rock, ore,
# tool ...) and the server sets their driver and item ID when it starts,
# so do not set driver=, ID= or arg= here.
# Rocks need flag=IF_MOVEBLOCK, ores, bars and tools need flag=IF_TAKE.
#

# ---- rocks (placed on the map with zones/<area>/*.place) ----

rock_copper:
name="Copper Rock"
description="A rock with veins of copper ore."
sprite=64120
value=0
flag=IF_MOVEBLOCK
;

rock_tin:
name="Tin Rock"
description="A rock with veins of tin ore."
sprite=64119
value=0
flag=IF_MOVEBLOCK
;

