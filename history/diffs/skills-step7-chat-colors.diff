diff -u a/talk.c b/talk.c
--- a/talk.c	2026-10-13 10:40:26.266407989 +0000
+++ b/talk.c	2026-10-13 10:40:26.326169084 +0000
@@ -18,6 +18,26 @@
 #include "talk.h"
 #include "database.h"
 
+// Colours for "Name says: \"...\"" lines sent to a player's client (protocol CHAT_COLOR_VERSION):
+// a player's name becomes a hidden link (the client shows those in the player name colour),
+// an NPC's words get colour 20 (light yellow). Characters still get the plain text,
+// since NPC drivers parse it. Returns buf when the line is not speech by co.
+static char *speech_colors(char *buf, int co, char *out, size_t size) {
+    size_t n;
+    char *q;
+
+    if (co < 1 || co >= MAXCHARS || !ch[co].name[0]) return buf;
+
+    n = strlen(ch[co].name);
+    if (strncmp(buf, ch[co].name, n) || buf[n] != ' ') return buf;
+    if (!(q = strstr(buf + n, ": \""))) return buf;
+
+    if (ch[co].flags & CF_PLAYER) snprintf(out, size, "\260c17%s\260c18%s", ch[co].name, buf + n);
+    else snprintf(out, size, "%.*s\260c20%s", (int)(q + 2 - buf), buf, q + 2);
+
+    return out;
+}
+
 // this is the low level "send text to character" routine ALL other functions MUST use
 // make sure you use log_char(cn,type,"%s",text) if text is NOT a format string.
 int log_char(int cn, int type, int dat1, char *format, ...) {
@@ -44,8 +64,14 @@
         if (!isprint(buf[n]) && buf[n] != 176 && buf[n] > 31) buf[n] = ' ';
 
     if (ch[cn].flags & CF_PLAYER) {
+        char colored[1100];
+        char *text = (char *)buf;
+
         nr = ch[cn].player;
-        if (!log_player(nr, type, "%s", buf)) return 0;
+        if ((type == LOG_TALK || type == LOG_SHOUT) && get_player_version(nr) >= CHAT_COLOR_VERSION) {
+            text = speech_colors(text, dat1, colored, sizeof(colored));
+        }
+        if (!log_player(nr, type, "%s", text)) return 0;
     } else {
         notify_char(cn, NT_TEXT, type, (intptr_t)xstrdup(buf, IM_TALK), dat1);
     }
