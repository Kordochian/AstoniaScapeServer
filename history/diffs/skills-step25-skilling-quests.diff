+++ new/zones/generic/skillquests.cfg	2026-10-14 21:57:23.995769476 +0000
@@ -0,0 +1,443 @@
+# =====================================================================
+# skillquests.cfg - skilling quests and the daily task board (Astonia rebuild)
+# =====================================================================
+#
+# Read when an area starts (after skills.cfg and skilling.cfg, whose keys it uses). Code: src\skillquest.c.
+# An error here stops the area from starting, like the other .cfg files; the area log names the line.
+#
+# The NPCs use character driver 160 and arg="npc=KEY;dir=N;" in their .chr template (zones\40\thornwood.chr).
+# Players talk to them:
+#   quest givers:  "quest" (what is there to do), "accept", "done" (hand in everything)
+#   task board:    "task" (get or show today's task), "done", "cancel"
+# /tasks lists a player's progress. /tasks reset (god) resets today's task count,
+# /tasks give <KEY> [count] (god) hands out skilling items for testing.
+#
+# ---------- quest blocks ----------
+#   KEY:                 any name, used by after=
+#   type=quest
+#   quest=               questlog number. Needs an entry in questlog[] in src\questlog.c AND in the client's
+#                        _game_questlog[] (src\gui\questlog.c) or it does not show in the quest log.
+#   npc=                 NPC key that gives it (the npc= in its arg). One NPC gives its quests in file order.
+#   skill= level=        skill level needed to accept it (optional)
+#   after=               quest KEY that must be done first (optional; same NPC is already in order)
+#   need=THING,count     what the player brings (up to 4). THING is a skilling.cfg key: a resource
+#                        (COPPER_ORE), a tool (IRON_AXE) or a recipe that makes an item (SMITH_IRON_DAGGER
+#                        counts smithed Iron Daggers only, not bought ones)
+#   xp=SKILL,amount      skill XP reward (up to 4). The global rate= in skills.cfg applies (75% now).
+#   gold=                gold coins reward
+#   reward=THING[,count] item reward (a skilling.cfg key as for need=)
+#   offer= remind= thanks=   what the NPC says when offering, while it is open, and when it is done
+#
+# For scale (skills.cfg, before the rate): level 15 needs 2,238 XP in all, level 30 needs 11,890,
+# level 45 needs 52,500.
+#
+# ---------- task blocks (daily task board) ----------
+#   KEY:
+#   type=task
+#   id=                  saved in the player's data: never change or reuse
+#   skill= level= maxlevel=   who gets it (skill level in this range)
+#   need=THING,min,max   asks for a random count from min to max
+#   xp_each=             XP per item for skill=
+#   silver_each=         money per item, in silver (100 silver = 1 gold)
+#   text=                what the board NPC says; {count} and {item} are filled in
+#
+# ---------- config ----------
+config:
+board=BOARD              # NPC key of the task board NPC
+board_quest=95           # questlog entry that is open while a task is taken
+tasks_per_day=3          # tasks a player can take per day (cancelled ones count)
+reset_hour=0             # hour (server time, UTC on most servers) when the day's count resets
+bonus_gold=50            # extra gold for finishing all of the day's tasks
+;
+
+# =====================================================================
+# Mining - Garrick, the mine foreman (the rocks north of the village square)
+# =====================================================================
+MINING_1:
+type=quest
+quest=81
+npc=MINER
+skill=MINING
+level=1
+need=COPPER_ORE,15
+need=TIN_ORE,15
+xp=MINING,500
+gold=25
+reward=IRON_PICKAXE
+offer="The smithy eats ore faster than my lads can dig it. Grab a pickaxe from the supply crate by the smithy and dig me some copper and tin."
+remind="Copper and tin, friend. The rocks are just east of here."
+thanks="Good honest ore! Take this iron pickaxe, it bites deeper than bronze."
+;
+
+MINING_2:
+type=quest
+quest=82
+npc=MINER
+skill=MINING
+level=15
+need=IRON_ORE,25
+xp=MINING,2500
+gold=75
+reward=STEEL_PICKAXE
+offer="There is iron in these hills, but it takes a steady hand to get it out."
+remind="Iron ore, from the reddish rocks by the mine."
+thanks="Fine iron. Here, a steel pickaxe. Thou hast earned it."
+;
+
+MINING_3:
+type=quest
+quest=83
+npc=MINER
+skill=MINING
+level=30
+need=COAL,40
