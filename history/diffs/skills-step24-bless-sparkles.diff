-int bless_someone(int co, int strength, int duration) {
+// How many sparkles Bless shows (the effect strength the client draws): the old Bless modifier,
+// skill value plus (INT + INT + WIS) / 5, divided by 4. Display only, Bless no longer changes stats.
+static int bless_shown(int cn) {
+    if (cn < 1 || cn >= MAXCHARS) return 0;
+    return (ch[cn].value[0][V_BLESS] + (ch[cn].value[0][V_INT] * 2 + ch[cn].value[0][V_WIS]) / 5) / 4;
+}
