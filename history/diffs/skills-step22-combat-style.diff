+#define SV_COMBATSTYLE 58
+#define STYLE_CLIENT_VERSION 11
+int skill_get_style(int cn);
+int skill_set_style(int cn, int style);
+void skill_melee_damage_xp(int cn, int dam);
+void style_command(int cn, char *arg);
 
