         set_sector(ch[cn].x, ch[cn].y);
-        log_char(cn, LOG_SYSTEM, 0, "Thou gained a level! Thou art level %d now.", ch[cn].level);
+        log_char(cn, LOG_SYSTEM, 0, "Thou gained a level! Thy combat level is %d now.", ch[cn].level);
 
         if (ch[cn].saves < 3) {
             ch[cn].saves++;
