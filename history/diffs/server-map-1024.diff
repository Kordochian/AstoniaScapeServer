+// Number that identifies a map position in this area (for player data such as used chests).
+// Positions inside the old 256x256 map keep their old numbers, so saved data stays valid.
+static inline int map_pos_id(int x, int y) {
+    if (x < 256 && y < 256) return x + (y << 8) + (areaID << 16);
+    return (1 << 30) | (areaID << 20) | (y << 10) | x;
+}
