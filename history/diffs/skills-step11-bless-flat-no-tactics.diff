 # Bless (the spell) does not change combat stats any more. While blessed,
-# a character gets bless_gather percent of the spell's strength added to the
-# chance per try at rocks, trees and plants, and bless_craft percent of it
-# taken off the fail chance of recipes that have fail=. A strength 60 Bless
-# with 20 gives +12% per try and -12% fail.
+# a character gets bless_gather percent added to the chance per try at
+# rocks, trees and plants, and bless_craft percent taken off the fail chance
+# of recipes that have fail=. bless_gather_strength / bless_craft_strength
+# add that percent of the spell's strength on top (0 = flat bonus only;
+# 10 would give a strength 60 Bless another +6%).
 config:
-bless_gather=20
-bless_craft=20
+bless_gather=10
+bless_craft=10
+bless_gather_strength=0
+bless_craft_strength=0
 ;
 
