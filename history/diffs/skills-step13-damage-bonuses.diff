+
+// ---------- damage bonuses (combat) ----------
+
+// skills whose gear modifiers add damage instead of skill levels (see update_char in create.c)
+int is_damage_skill(int v) {
+    return v == V_HAND || v == V_DAGGER || v == V_STAFF || v == V_SWORD || v == V_TWOHAND || v == V_FIRE || v == V_FLASH;
+}
+
+// sum of the modifiers for value v on the items cn wears (slots 0-11), with the same quality
+// effectivity update_char uses
+static int gear_points(int cn, int v) {
+    int n, m, in, sum = 0;
+    double effectivity;
+
+    for (n = 0; n < 12; n++) {
+        if (!(in = ch[cn].item[n]) || in >= MAXITEM) continue;
+        if (it[in].complexity > 0) {
+            if ((int)(it[in].complexity * 1.2) > it[in].quality) effectivity = (double)it[in].quality / it[in].complexity;
+            else effectivity = 1.2;
+        } else effectivity = 1.0;
+        for (m = 0; m < MAXMOD; m++) {
+            if (it[in].mod_index[m] == v && it[in].mod_value[m]) sum += (int)round(it[in].mod_value[m] * effectivity);
+        }
+    }
+    return sum;
+}
+
+// damage in percent (100 = unchanged) for cn hitting with skill v. level: also add the weapon skill
+// level bonus (melee; spells already grow with their level). The level bonus is for players only:
+// NPC damage stays as their templates set it.
+int damage_percent(int cn, int v, int level) {
+    int pct = 100;
+
+    if (cn < 1 || cn >= MAXCHARS || v < 0 || v >= V_MAX) return 100;
+
+    if (level && (ch[cn].flags & CF_PLAYER)) pct += ch[cn].value[1][v] * weapon_level_damage / 100;
+    pct += min(gear_damage_cap, gear_points(cn, v) * gear_damage / 100);
+
+    return max(0, pct);
+}
