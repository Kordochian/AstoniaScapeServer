     unsigned int a, b;
 
     if (!cn) { // created: make sure the count and description are set
-        if (!stack_count(in)) stack_set(in, 1);
+        stack_set(in, stack_count(in) ? stack_count(in) : 1); // also picks the stack sprite
         return;
     }
     if (!it[in].carried) return;
