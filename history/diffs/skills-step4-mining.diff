diff -ruN a/zones/generic/skilling.cfg b/zones/generic/skilling.cfg
--- a/zones/generic/skilling.cfg	1970-01-01 00:00:00.000000000 +0000
+++ b/zones/generic/skilling.cfg	2026-10-13 08:51:26.540878432 +0000
@@ -0,0 +1,510 @@
+# =====================================================================
+# skilling.cfg - Mining and Smithing (Astonia rebuild)
+# =====================================================================
+#
+# Every block is   KEY:  setting=value ...  ;     (# starts a comment)
+# Items are templates from zones/generic/skilling.itm (or any other .itm).
+#
+# type=resource   something that stacks in the inventory (ore, coal, bars)
+#     id=  item=
+# type=rock       a rock on the map, mined with a pickaxe
+#     id=  item=  ore=RESOURCE  level= (Mining)  xp= (per ore)
+#     ores= (ores before it is empty)  respawn= (seconds until it refills)
+#     empty_sprite= (sprite while empty)
+# type=pickaxe    id=  item=  level= (Mining to use it)  power= (1 = basic,
+#                 each point is +10% chance per swing)
+# type=hammer     id=  item=   (needed to use an anvil)
+# type=furnace    id=  item=   (/smelt works within 3 tiles)
+# type=anvil      id=  item=   (/smith works within 3 tiles)
+# type=supply     id=  item=  give=TOOL ...  (click it to get the listed
+#                 tools you do not carry yet)
+# type=smelt      recipe at a furnace: make=RESOURCE  need=RESOURCE,count ...
+#                 level= (Smithing)  xp= (per bar)  fail= (percent chance to
+#                 lose the ores at that level, 2 less per level above)
+# type=smith      recipe at an anvil: make=RESOURCE or item template
+#                 need=RESOURCE,count ...  level=  xp=  name= description=
+#                 (name and description of the made item, default: template's)
+#
+# id= is saved with the items players carry: NEVER change or reuse an id
