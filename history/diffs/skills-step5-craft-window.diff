diff --git a/src/skilling.h b/src/skilling.h
index e31a406..d2d4a36 100644
--- a/src/skilling.h
+++ b/src/skilling.h
@@ -8,3 +8,12 @@
 int skilling_load(void); // after the item templates are loaded
 int skilling_item_driver(int nr, int in, int cn);
 int skilling_command(int cn, char *cmd, char *args); // /smelt, /smith
+
+// furnace / anvil window in the client (protocol 6). Uses a free command number of client.h (was SV_RESERVED3).
+// u16 total length, station (1 furnace, 2 anvil), flags (CRAFT_OPEN, CRAFT_NOHAMMER), Smithing level, count,
+// then per recipe: nr, level, can make (0-100), xp u16, sprite u32, key, name, needs (each: u8 length + text).
+// The client makes things by sending "/smelt <key> <count>" or "/smith <key> <count>".
+#define SV_CRAFTLIST 56
+#define CRAFT_CLIENT_VERSION 6
+#define CRAFT_OPEN 1 // open the window (else only refresh it if it shows this station)
+#define CRAFT_NOHAMMER 2 // anvil: the character has no hammer
