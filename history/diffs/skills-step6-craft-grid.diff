--- a/src/skilling.c
+++ b/src/skilling.c
@@ -673,7 +673,7 @@ static int craft_str(unsigned char *buf, int p, const char *s, int maxlen) {
 
 static void send_craft_list(int cn, int rtype, int open) {
     static unsigned char buf[16384];
-    int nr, r, p, n = 0, lvl, need, sprite;
+    int nr, r, p, n = 0, lvl, need, sprite, m, nmat = 0, mat[256];
     char text[256];
 
     if (!(nr = ch[cn].player) || get_player_version(nr) < CRAFT_CLIENT_VERSION) return;
@@ -686,7 +686,7 @@ static void send_craft_list(int cn, int rtype, int open) {
     p = 7;
     for (r = 0; r < nskdef && n < 255; r++) {
         if (skdef[r].type != rtype) continue;
-        if (p > (int)sizeof(buf) - 400) break;
+        if (p > (int)sizeof(buf) - 4000) break; // room for this recipe and the material list
         if (skdef[r].make_res != -1) sprite = item_template(skdef[skdef[r].make_res].tmp)->sprite;
         else sprite = item_template(skdef[r].make_tmp)->sprite;
         need_text(r, text);
@@ -698,12 +698,30 @@ static void send_craft_list(int cn, int rtype, int open) {
         p += 2;
         *(unsigned int *)(buf + p) = sprite;
         p += 4;
+        if (skdef[r].nneed > 0) {
+            buf[p++] = skdef[r].need[0];
+            buf[p++] = min(skdef[r].needcnt[0], 255);
+            for (m = 0; m < nmat && mat[m] != skdef[r].need[0]; m++);
+            if (m == nmat) mat[nmat++] = skdef[r].need[0];
+        } else {
+            buf[p++] = 255;
+            buf[p++] = 0;
+        }
         p = craft_str(buf, p, skdef[r].key, 31);
         p = craft_str(buf, p, skdef[r].name, 39);
         p = craft_str(buf, p, text, 160);
         n++;
     }
     buf[6] = n;
+
+    // the materials: what the client groups by, and how many the character carries
+    buf[p++] = nmat;
+    for (m = 0; m < nmat; m++) {
+        buf[p++] = mat[m];
+        *(unsigned short *)(buf + p) = min(res_count(cn, mat[m]), 65535);
+        p += 2;
+        p = craft_str(buf, p, item_template(skdef[mat[m]].tmp)->name, 39);
+    }
     *(unsigned short *)(buf + 1) = p;
     psend(nr, (char *)buf, p);
 }
