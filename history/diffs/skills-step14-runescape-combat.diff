@@ -63,22 +63,26 @@
 # add that percent of the spell's strength on top (0 = flat bonus only;
 # 10 would give a strength 60 Bless another +6%).
 #
-# Damage (combat, all percent):
-# weapon_level_damage: a player's weapon skill level adds this percent of
-#   the level to melee damage (100 = +1% per level: Sword 50 = +50%).
-#   NPCs don't get it (their damage stays as their templates set it).
-# gear_damage: modifiers on worn gear for a weapon skill (Hand, Dagger,
-#   Staff, Sword, Two-Handed), Fire or Lightning add this percent of the
-#   points to that skill's damage (50: a +20 Lightning ring = +10%) instead
-#   of raising the skill. gear_damage_cap is the most gear can add.
+# Combat (RuneScape-style hits, step 14; all percent):
+# tactics_boost: this percent of Tactics is added to the effective melee
+#   levels (accuracy = (weapon skill + Attack) / 2, strength = (weapon
+#   skill + STR) / 2, defence = (weapon skill + Parry) / 2).
+# min_hit: a melee hit that lands rolls between this percent of the max hit
+#   and the max hit, so a hit always does something.
+# armor_soak: armor takes off at most this percent of a melee hit.
+# magic_damage_cap: the most Magic Damage % gear can add to Fire/Lightning.
+# Gear no longer changes skills; weapons and armour carry Melee Accuracy,
+# Melee Strength, Melee Defence, Magic Accuracy, Magic Damage and Magic
+# Defence (mod_index=V_MELEE_ACC ... in the .itm files).
 config:
 bless_gather=10
 bless_craft=10
 bless_gather_strength=0
 bless_craft_strength=0
-weapon_level_damage=100
-gear_damage=50
-gear_damage_cap=25
+tactics_boost=10
+min_hit=20
+armor_soak=75
+magic_damage_cap=50
 ;
 
