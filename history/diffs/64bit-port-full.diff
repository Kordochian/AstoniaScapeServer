+struct qa {
+    char *word[20];
+    char *answer;
+    int answer_code;
+};
+
+struct qa qa[] = {
+    {{"how", "are", "you", NULL}, "I'm fine!", 0},
+    {{"hello", NULL}, "Hello, %s!", 0},
+    {{"hi", NULL}, "Hi, %s!", 0},
+    {{"greetings", NULL}, "Greetings, %s!", 0},
+    {{"hail", NULL}, "And hail to you, %s!", 0},
+    {{"what's", "up", NULL}, "Everything that isn't nailed down.", 0},
