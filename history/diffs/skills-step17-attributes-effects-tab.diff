+// Attributes, one job each (George 2026-10-13). They never change skill levels (the skills menu shows the
+// trained level); they work inside the formulas, each adding this percent of the attribute:
+// Strength -> the melee strength level ((weapon skill + STR) / 2 below)
+// Agility -> the melee accuracy and defence levels (agility_bonus) and Speed (agility_speed, update_char)
+// Intuition -> spell power of Bless, Heal, Freeze, Magic Shield, Lightning and Fire (spellpower())
+// Wisdom -> Meditate's mana regeneration and Immunity against spells (wisdom_bonus)
+int attr_agility = 10, attr_agility_speed = 40, attr_intuition = 20, attr_wisdom = 20;
+
+// what the attributes add to a value in update_char(): only Speed now
+int attribute_bonus(int cn, int v) {
+    if (v == V_SPEED) return ch[cn].value[0][V_AGI] * attr_agility_speed / 100;
+    return 0;
+}
+
+static int agility_boost(int cn) {
+    return ch[cn].value[0][V_AGI] * attr_agility / 100;
+}
+
+int wisdom_boost(int cn) {
+    return ch[cn].value[0][V_WIS] * attr_wisdom / 100;
+}
+
+int intuition_boost(int cn) {
+    return ch[cn].value[0][V_INT] * attr_intuition / 100;
+}
+
+// Immunity against spells: the skill plus Wisdom
+int immunity_value(int cn) {
+    return ch[cn].value[0][V_IMMUNITY] + wisdom_boost(cn);
+}
